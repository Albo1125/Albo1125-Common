<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- RAGE Plugin Hook only loads .NET Framework assemblies, and GTA V is 64-bit only. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <AssemblyName>Albo1125.Common</AssemblyName>
    <RootNamespace>Albo1125.Common</RootNamespace>
    <Version>6.7.0</Version>
    <AssemblyVersion>6.7.0.0</AssemblyVersion>
    <FileVersion>6.7.0.0</FileVersion>
    <Description>Common assembly for Albo1125's LSPDFR mods.</Description>
    <Company>Albo1125</Company>
    <Product>Albo1125.Common</Product>
    <Copyright>Copyright © 2019 - Albo1125</Copyright>

    <!-- LSPDFR isn't on NuGet: copy LSPD First Response.dll from your LSPDFR download into dependencies\. -->
    <LspdfrDllPath Condition="'$(LspdfrDllPath)' == ''">$(MSBuildThisFileDirectory)dependencies\LSPD First Response.dll</LspdfrDllPath>
    <!-- Falls back to a DLLS folder shared by projects next to this repository. -->
    <LspdfrDllPath Condition="!Exists('$(LspdfrDllPath)') And Exists('$(MSBuildThisFileDirectory)..\..\DLLS\LSPD First Response.dll')">$(MSBuildThisFileDirectory)..\..\DLLS\LSPD First Response.dll</LspdfrDllPath>
    <RphSdkPath Condition="'$(RphSdkPath)' == ''">$(MSBuildThisFileDirectory)dependencies\RagePluginHookSDK.dll</RphSdkPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LSPD First Response">
      <HintPath>$(LspdfrDllPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Prefers the SDK from the RAGE Plugin Hook download, falls back to NuGet. -->
  <ItemGroup Condition="Exists('$(RphSdkPath)')">
    <Reference Include="RagePluginHook">
      <HintPath>$(RphSdkPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(RphSdkPath)')">
    <PackageReference Include="RagePluginHook" Version="1.124.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the project build without the .NET Framework targeting pack installed (e.g. on macOS/CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

</Project>
